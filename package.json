{
  "name": "yuseong-minwon",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @minwon/api start:dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @minwon/api start:prod",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait db",
    "db:test:up": "docker compose up -d --wait db-test",
    "db:migrate": "pnpm --filter @minwon/api exec prisma migrate deploy",
    "seed:import": "pnpm --filter @minwon/api seed:import",
    "smoke": "pnpm --filter @minwon/api smoke",
    "desktop:dev": "pnpm --filter @minwon/desktop dev"
  }
}
