    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "exceljs": "^4.4.0",
    "openai": "^7.27.0",
    "pg": "^8.23.1",
    "pgvector": "^0.2.1",
