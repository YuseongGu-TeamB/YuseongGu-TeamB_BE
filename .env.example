# ── LLM (OpenAI 호환) ─────────────────────────────────────
# LLM 엔드포인트. 시연(Ollama 클라우드): https://ollama.com/v1
OPENAI_BASE_URL=http://localhost:11434/v1
# 로컬 ollama는 아무 값이나 가능. Ollama 클라우드는 계정 API 키 (.env에만 넣고 커밋하지 말 것)
OPENAI_API_KEY=ollama
# 생성 모델. 개발: qwen2.5:7b(로컬) / 시연: gemma4:31b(클라우드)
MODEL=qwen2.5:7b
# 응답 최대 토큰. 레거시 250은 3b 기준. 잘림 발생 시 로그 확인
LLM_MAX_TOKENS=512
# 공문이므로 낮게
LLM_TEMPERATURE=0.3
# LLM 호출 타임아웃(ms)
LLM_TIMEOUT_MS=120000
# 후보 병렬 생성 한도. CPU 전용 서버면 1
LLM_CONCURRENCY=2
# ollama 전용 옵션(JSON). 설정 시에만 extra_body로 전달. 예: {"keep_alive":-1,"num_ctx":4096,"num_thread":4}
OLLAMA_OPTIONS=
# 모델별 추가 파라미터(JSON). extra_body에 병합. 예: {"reasoning_effort":"low"}
LLM_EXTRA_BODY=

# ── 임베딩 (LLM과 별도. 외부로 돌리지 않는다) ─────────────
# 임베딩 엔드포인트. OPENAI_BASE_URL로 대체하지 않는다
EMBEDDING_BASE_URL=http://localhost:11434/v1
# 바꾸면 POST /dev/corpus/reembed로 재임베딩 필요
EMBEDDING_MODEL=bge-m3
# 벡터 컬럼 차원. 모델 출력과 다르면 시작 실패
EMBEDDING_DIM=1024

# ── 검색 ─────────────────────────────────────────────────
# mock | vector
SEARCH_ENGINE=vector
# 검색 결과 개수
SEARCH_TOP_K=3
# true면 pg_trgm 유사도를 섞는다
SEARCH_HYBRID=false

# ── DB ───────────────────────────────────────────────────
# docker-compose 기본값과 일치
DATABASE_URL=postgresql://app:app@localhost:5432/minwon
# 테스트 전용 DB(docker compose up -d db-test)
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/minwon_test

# ── API ──────────────────────────────────────────────────
# API 포트
PORT=3000
# 허용 origin(쉼표 구분)
CORS_ORIGINS=http://localhost:5173
# 민원 본문 최대 길이
COMPLAINT_MAX_CHARS=5000
# 여기 적힌 구성요소가 로컬이 아니면 시작 중단(db,embedding,llm 중 선택)
REQUIRE_LOCAL=db,embedding

# ── 개발자 전용 시드 API ─────────────────────────────────
# true일 때만 /dev 라우트 등록
DEV_API_ENABLED=false
# X-Dev-Key 헤더와 일치해야 함
DEV_API_KEY=
